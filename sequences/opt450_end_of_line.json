// End-of-line test for the simulated OPT-450 power optimizer.
// Comments are allowed in sequence files.
{
  "name": "OPT-450 End-of-Line Test",
  "product": "OPT-450",
  "stopOnFail": true,
  "defaultTimeoutMs": 1000,
  "steps": [
    { "name": "Reset unit",           "type": "command", "command": "*RST" },
    { "name": "Identify",             "type": "query",   "command": "*IDN?",     "expectRegex": "^[A-Z]+,OPT-450,[A-Z0-9]+,[0-9.]+$" },
    { "name": "Firmware version",     "type": "query",   "command": "FW?",       "expectEquals": "1.4.2" },
    { "name": "Self test",            "type": "query",   "command": "SELFTEST?", "expectEquals": "0" },

    { "name": "Input voltage",        "type": "measure", "command": "MEAS:VIN?",  "min": 30.0, "max": 60.0, "unit": "V", "retries": 3, "delayMs": 50 },
    { "name": "Safe-mode output",     "type": "measure", "command": "MEAS:VOUT?", "min": 0.8,  "max": 1.2,  "unit": "V" },

    { "name": "Close output relay",   "type": "command", "command": "RELAY ON", "delayMs": 20 },
    { "name": "Output voltage",       "type": "measure", "command": "MEAS:VOUT?", "min": 38.0, "max": 41.0, "unit": "V", "retries": 1, "delayMs": 100 },
    { "name": "Output current",       "type": "measure", "command": "MEAS:IOUT?", "min": 7.5,  "max": 9.0,  "unit": "A", "retries": 1 },
    { "name": "Board temperature",    "type": "measure", "command": "MEAS:TEMP?", "min": 10.0, "max": 60.0, "unit": "C", "retries": 1, "timeoutMs": 500 },

    { "name": "Open output relay",    "type": "command", "command": "RELAY OFF", "alwaysRun": true }
  ]
}
